# Copy to .env and fill in. Never commit .env.

# --- Google Cloud / Gemini on Vertex AI ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Check current model names in Vertex AI Model Garden before using these.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_ALT=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low

# --- Databases ---
# Read-only role used by the app and MCP server (see scripts/setup_readonly_role.sql)
DATABASE_URL=postgresql://copilot_ro:CHANGE_ME@your-host/your-db?sslmode=require
# Admin connection: setup and evals/build_expected.py only, never used by the app
ADMIN_DATABASE_URL=postgresql://admin:CHANGE_ME@your-host/your-db?sslmode=require
# Writable app-state role for the LangGraph checkpointer + daily request counter
APP_STATE_DATABASE_URL=postgresql://copilot_app:CHANGE_ME@your-host/your-db?sslmode=require

# --- Warehouse metadata ---
# Comma-separated schema.table allow-list (the dbt marts the agent may query)
# Leave ALLOWED_TABLES unset to use the 9 built-in dbt_dev marts (see config.py).
# ALLOWED_TABLES=dbt_dev.dim_hospital,dbt_dev.fct_medicare_drg
DEFAULT_SCHEMA=dbt_dev
DBT_TARGET_DIR=./dbt_target
APPROVAL_ROW_THRESHOLD=2000000

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- App ---
APP_ACCESS_CODE=choose-a-code
DAILY_REQUEST_CAP=200
GITHUB_REPO_URL=https://github.com/YOUR_GITHUB_USER/warehouse-copilot
COPILOT_RO_PASSWORD=
